# Prisma Postgres connection string (console.prisma.io → your DB → Connect)
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional: after this moment the form returns "RSVPs are closed"
RSVP_DEADLINE="2027-07-15T23:59:59+03:00"

# Admin accounts, used only by `npm run db:seed`
ADMIN_1_EMAIL="bride@example.com"
ADMIN_1_PASSWORD="change-me"
ADMIN_2_EMAIL="groom@example.com"
ADMIN_2_PASSWORD="change-me-too"

# Signs admin session cookies. Generate one: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
