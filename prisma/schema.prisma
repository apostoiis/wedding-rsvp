generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Rsvp {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  attending Boolean
  adults    Int      @default(1)
  kids      Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}
