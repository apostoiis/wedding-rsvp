{
  "name": "wedding-rsvp",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch server/dev.ts\" \"vite\"",
    "build": "prisma generate && vite build",
    "typecheck": "tsc",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.21.0"
}
